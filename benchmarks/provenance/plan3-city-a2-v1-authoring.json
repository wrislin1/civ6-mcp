    "operations": [
      {
        "context": "gamecore",
        "index": 0,
        "lua": "local t = Players[0]:GetTreasury()\nt:ChangeGoldBalance(500 - t:GetGoldBalance())\nprint(\"OK|gold \" .. t:GetGoldBalance())\n",
        "readback": [
          "OK|gold 500"
        ],
        "readback_lua": "local g = Players[0]:GetTreasury():GetGoldBalance()\nif g >= 500 then print(\"OK|gold \" .. g) else print(\"ERR|gold \" .. g) end\n",
        "readback_ok": true,
        "result": [
          "OK|gold 500"
        ]
      },
      {
        "context": "gamecore",
        "index": 1,
        "lua": "local c = nil\nfor _, city in Players[0]:GetCities():Members() do\n  if Locale.Lookup(city:GetName()) == \"Gwangju\" then c = city end\nend\nif c == nil then print(\"ERR|Gwangju missing\") return end\nlocal b = GameInfo.Buildings[\"BUILDING_MONUMENT\"].Index\nif not c:GetBuildings():HasBuilding(b) then print(\"ERR|Gwangju has no monument\") return end\nc:GetBuildings():SetPillaged(b, true)\nprint(\"OK|pillaged|Gwangju|BUILDING_MONUMENT\")\n",
        "readback": [
          "OK|repair_city|Gwangju|BUILDING_MONUMENT|pillaged"
        ],
        "readback_lua": "local c = nil\nfor _, city in Players[0]:GetCities():Members() do\n  if Locale.Lookup(city:GetName()) == \"Gwangju\" then c = city end\nend\nlocal b = GameInfo.Buildings[\"BUILDING_MONUMENT\"].Index\nif c ~= nil and c:GetBuildings():IsPillaged(b) then\n  print(\"OK|repair_city|Gwangju|BUILDING_MONUMENT|pillaged\")\nelse\n  print(\"ERR|Gwangju monument is not pillaged\")\nend\n",
        "readback_ok": true,
        "result": [
          "OK|pillaged|Gwangju|BUILDING_MONUMENT"
        ]
      },
      {
        "context": "gamecore",
        "index": 2,
        "lua": "local c = nil\nfor _, city in Players[0]:GetCities():Members() do\n  if Locale.Lookup(city:GetName()) == \"Jeonju\" then c = city end\nend\nif c == nil then print(\"ERR|Jeonju missing\") return end\nlocal info = GameInfo.Buildings[\"BUILDING_GRANARY\"]\nlocal cb = c:GetBuildings()\nif not cb:HasBuilding(info.Index) then print(\"ERR|Jeonju has no granary to remove\") return end\nif cb.RemoveBuilding == nil then\n  print(\"ERR|CityBuildings:RemoveBuilding is not available in GameCore\") return\nend\ncb:RemoveBuilding(info.Index)\nprint(\"OK|removed|Jeonju|BUILDING_GRANARY\")\n",
        "readback": [
          "OK|housing_city|Jeonju|surplus -1|granary_housing 2"
        ],
        "readback_lua": "local minimum_surplus = 1\nlocal c = nil\nfor _, city in Players[0]:GetCities():Members() do\n  if Locale.Lookup(city:GetName()) == \"Jeonju\" then c = city end\nend\nif c == nil then print(\"ERR|Jeonju missing\") return end\nlocal info = GameInfo.Buildings[\"BUILDING_GRANARY\"]\nlocal gain = info.Housing or 0\nlocal surplus = c:GetGrowth():GetHousing() - c:GetPopulation()\nlocal granary = c:GetBuildings():HasBuilding(info.Index)\nif not granary and surplus < minimum_surplus and surplus + gain >= minimum_surplus then\n  print(\"OK|housing_city|Jeonju|surplus \" .. surplus .. \"|granary_housing \" .. gain)\nelse\n  print(\"ERR|Jeonju surplus \" .. surplus .. \" granary_housing \" .. gain\n        .. \" has_granary \" .. tostring(granary))\nend\n",
        "readback_ok": true,
        "result": [
          "OK|removed|Jeonju|BUILDING_GRANARY"
        ]
      },
      {
        "context": "gamecore",
        "index": 3,
        "lua": "local p = Map.GetPlot(67, 22)\nif p == nil then print(\"ERR|(67,22) missing\") return end\nif p:GetOwner() ~= -1 then print(\"ERR|(67,22) already owned by \" .. p:GetOwner()) return end\np:SetOwner(0, 131073)\nprint(\"OK|owner|67,22|Jeonju\")\n",
        "readback": [
          "OK|replacement_site|67,22|owned|TERRAIN_GRASS_HILLS|bare"
        ],
        "readback_lua": "local p = Map.GetPlot(67, 22)\nif p ~= nil and p:GetOwner() == 0\n    and GameInfo.Terrains[p:GetTerrainType()].TerrainType == \"TERRAIN_GRASS_HILLS\"\n    and p:GetFeatureType() < 0 and p:GetResourceType() < 0 and p:GetDistrictType() < 0 then\n  print(\"OK|replacement_site|67,22|owned|TERRAIN_GRASS_HILLS|bare\")\nelse\n  print(\"ERR|(67,22) is not Korea's bare grass hills\")\nend\n",
        "readback_ok": true,
        "result": [
          "OK|owner|67,22|Jeonju"
        ]
      },
      {
        "context": "gamecore",
        "index": 4,
        "lua": "local p = Map.GetPlot(67, 22)\nif p == nil then print(\"ERR|(67,22) missing\") return end\nImprovementBuilder.SetImprovementType(p, GameInfo.Improvements[\"IMPROVEMENT_MINE\"].Index, 0)\nprint(\"OK|mine|67,22\")\n",
        "readback": [
          "OK|replacement_site|67,22|IMPROVEMENT_MINE|intact"
        ],
        "readback_lua": "local p = Map.GetPlot(67, 22)\nlocal imp = p ~= nil and p:GetImprovementType() or -1\nlocal info = imp >= 0 and GameInfo.Improvements[imp] or nil\nif info ~= nil and info.ImprovementType == \"IMPROVEMENT_MINE\"\n    and not p:IsImprovementPillaged() and p:GetOwner() == 0 then\n  print(\"OK|replacement_site|67,22|IMPROVEMENT_MINE|intact\")\nelse\n  print(\"ERR|(67,22) holds no intact owned mine\")\nend\n",
