    "operations": [
      {
        "context": "gamecore",
        "index": 0,
        "lua": "local CX, CY = 73, 19\nlocal function free(p)\n  return p ~= nil and not p:IsWater() and not p:IsImpassable() and not p:IsCity()\n    and p:GetUnitCount() == 0 and p:GetDistrictType() < 0\nend\nlocal function same(p, q)\n  return p ~= nil and q ~= nil and p:GetX() == q:GetX() and p:GetY() == q:GetY()\nend\nlocal archer = nil\nfor _, v in Players[0]:GetUnits():Members() do\n  if GameInfo.Units[v:GetType()].UnitType == \"UNIT_ARCHER\"\n      and v:GetX() == CX and v:GetY() == CY then archer = v end\nend\nif archer == nil then print(\"ERR|no archer garrisoned in Gongju\") return end\nlocal function guarded(x, y, a)\n  for _, v in Players[0]:GetUnits():Members() do\n    if v:GetID() ~= archer:GetID()\n        and GameInfo.Units[v:GetType()].FormationClass ~= \"FORMATION_CLASS_CIVILIAN\"\n        and Map.GetPlotDistance(x, y, v:GetX(), v:GetY()) <= 1 then return true end\n  end\n  return Map.GetPlotDistance(x, y, a:GetX(), a:GetY()) <= 1\nend\nlocal P, A, S, W = nil, nil, nil, nil\nfor y = 16, 22 do\n  for x = 70, 76 do\n    local p = Map.GetPlot(x, y)\n    if P == nil and free(p) and Map.GetPlotDistance(x, y, CX, CY) == 2 then\n      local a = nil\n      for d = 0, 5 do\n        local q = Map.GetAdjacentPlot(CX, CY, d)\n        if a == nil and free(q) and Map.GetPlotDistance(q:GetX(), q:GetY(), x, y) <= 2 then a = q end\n      end\n      if a ~= nil then\n        for d1 = 0, 5 do\n          local s = Map.GetAdjacentPlot(x, y, d1)\n          if P == nil and free(s) and not same(s, a) and not guarded(s:GetX(), s:GetY(), a) then\n            for d2 = 0, 5 do\n              local w = Map.GetAdjacentPlot(x, y, d2)\n              if P == nil and free(w) and not same(w, a) and not same(w, s)\n                  and Map.GetPlotDistance(w:GetX(), w:GetY(), s:GetX(), s:GetY()) >= 2 then\n                P, A, S, W = p, a, s, w\n              end\n            end\n          end\n        end\n      end\n    end\n  end\nend\nif P == nil then print(\"ERR|no attacker tile at distance 2 from Gongju admits the layout\") return end\nlocal att = UnitManager.InitUnit(63, \"UNIT_WARRIOR\", P:GetX(), P:GetY())\nif att == nil then print(\"ERR|barbarian spawn failed\") return end\natt:SetDamage(35)\nUnitManager.PlaceUnit(archer, A:GetX(), A:GetY())\nUnitManager.RestoreMovement(archer)\nlocal st = UnitManager.InitUnit(0, \"UNIT_SETTLER\", S:GetX(), S:GetY())\nif st == nil then print(\"ERR|settler spawn failed\") return end\nUnitManager.RestoreMovement(st)\nlocal ex = UnitManager.InitUnit(0, \"UNIT_WARRIOR\", W:GetX(), W:GetY())\nif ex == nil then print(\"ERR|warrior spawn failed\") return end\nex:SetDamage(80)\nUnitManager.RestoreMovement(ex)\nprint(\"OK|layout|attacker \" .. P:GetX() .. \",\" .. P:GetY() .. \"|archer \" .. A:GetX() .. \",\"\n  .. A:GetY() .. \"|civilian \" .. S:GetX() .. \",\" .. S:GetY() .. \"|expendable \" .. W:GetX()\n  .. \",\" .. W:GetY())\n",
        "readback": [
          "OK|attacker|72,21|hp 65",
          "OK|archer|74,20",
          "OK|civilian|73,22",
          "OK|expendable|71,21|hp 20"
        ],
        "readback_lua": "local CX, CY = 73, 19\nlocal ax, ay, n = nil, nil, 0\nfor _, u in Players[63]:GetUnits():Members() do\n  local p = Map.GetPlot(u:GetX(), u:GetY())\n  if Map.GetPlotDistance(u:GetX(), u:GetY(), CX, CY) == 2\n      and PlayersVisibility[0]:IsVisible(p:GetIndex()) then\n    n = n + 1\n    ax, ay = u:GetX(), u:GetY()\n    print(\"OK|attacker|\" .. ax .. \",\" .. ay .. \"|hp \" .. (u:GetMaxDamage() - u:GetDamage()))\n  end\nend\nif n ~= 1 then print(\"ERR|expected one visible attacker at distance 2 from Gongju, found \" .. n) return end\nlocal na, on_city = 0, 0\nfor _, v in Players[0]:GetUnits():Members() do\n  local info = GameInfo.Units[v:GetType()]\n  if info.UnitType == \"UNIT_ARCHER\" and Map.GetPlotDistance(v:GetX(), v:GetY(), CX, CY) == 1 then\n    na = na + 1\n    if Map.GetPlotDistance(v:GetX(), v:GetY(), ax, ay) > 2 then\n      print(\"ERR|archer beyond two tiles of the attacker\")\n    end\n    print(\"OK|archer|\" .. v:GetX() .. \",\" .. v:GetY())\n  end\n  if v:GetX() == CX and v:GetY() == CY and info.FormationClass == \"FORMATION_CLASS_LAND_COMBAT\" then\n    on_city = on_city + 1\n  end\nend\nif na ~= 1 then print(\"ERR|expected one archer beside Gongju, found \" .. na) end\nif on_city ~= 0 then print(\"ERR|a land combat unit still occupies Gongju's tile\") end\nlocal sx, sy, ns = nil, nil, 0\nfor _, v in Players[0]:GetUnits():Members() do\n  if GameInfo.Units[v:GetType()].UnitType == \"UNIT_SETTLER\" then\n    ns = ns + 1\n    sx, sy = v:GetX(), v:GetY()\n    print(\"OK|civilian|\" .. sx .. \",\" .. sy)\n  end\nend\nif ns ~= 1 then print(\"ERR|expected one settler, found \" .. ns) return end\nif Map.GetPlotDistance(sx, sy, ax, ay) ~= 1 then print(\"ERR|settler is not beside the attacker\") end\nfor _, v in Players[0]:GetUnits():Members() do\n  local info = GameInfo.Units[v:GetType()]\n  if info.FormationClass ~= \"FORMATION_CLASS_CIVILIAN\"\n      and Map.GetPlotDistance(sx, sy, v:GetX(), v:GetY()) <= 1 then\n    print(\"ERR|settler is covered by \" .. info.UnitType .. \" at \" .. v:GetX() .. \",\" .. v:GetY())\n  end\nend\nlocal nw = 0\nfor _, v in Players[0]:GetUnits():Members() do\n  if GameInfo.Units[v:GetType()].UnitType == \"UNIT_WARRIOR\" then\n    nw = nw + 1\n    print(\"OK|expendable|\" .. v:GetX() .. \",\" .. v:GetY() .. \"|hp \" .. (v:GetMaxDamage() - v:GetDamage()))\n    if Map.GetPlotDistance(v:GetX(), v:GetY(), ax, ay) ~= 1 then print(\"ERR|warrior is not beside the attacker\") end\n    if Map.GetPlotDistance(v:GetX(), v:GetY(), sx, sy) < 2 then print(\"ERR|warrior covers the settler\") end\n  end\nend\nif nw ~= 1 then print(\"ERR|expected one own warrior, found \" .. nw) end\n",
        "readback_ok": true,
        "result": [
          "OK|layout|attacker 72,21|archer 74,20|civilian 73,22|expendable 71,21"
